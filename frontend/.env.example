# Google OAuth Configuration
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Server-side secrets (not exposed to client)
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# JWT Secret for authentication
JWT_SECRET=your_jwt_secret_here

# MongoDB Connection URIs
# Main user database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database
# User activity database (separate for analytics)
MONGODB_ACTIVITY_URI=mongodb+srv://username:password@cluster.mongodb.net/activity_database

# Server Configuration
PORT=5000

# Anthropic Claude API Configuration
VITE_ANTHROPIC_API_KEY=sk-ant-api03-YOUR-API-KEY-HERE

# Optional: Specify model (default: claude-3-haiku-20240307 for cost efficiency)
VITE_CLAUDE_MODEL=claude-3-haiku-20240307

# Other available models:
# claude-3-opus-20240229 (most capable, highest cost)
# claude-3-sonnet-20240229 (balanced performance/cost)
# claude-3-haiku-20240307 (fastest, lowest cost)